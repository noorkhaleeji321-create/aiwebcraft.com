# AIWebCrafter Environment Variables Example Template
# (Do NOT put actual secret keys in this template file)

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# Gemini API Multi-Cluster Keys (comma-separated or single)
GEMINI_API_KEY="your_gemini_api_key_here"

# AI Provider Keys
OPENAI_API_KEY="your_openai_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Media & Image Providers
UNSPLASH_ACCESS_KEY="your_unsplash_access_key_here"
VITE_UNSPLASH_ACCESS_KEY="your_unsplash_access_key_here"
VITE_IMAGE_PROVIDER="Unsplash"

# App & Server Runtime
APP_URL="https://yourdomain.com"
NODE_ENV="production"
VITE_NODE_ENV="production"
PORT="3000"

# SEO, AdSense & Google Analytics
VITE_GSC_VERIFICATION="google-site-verification=your_gsc_token"
VITE_ADSENSE_PUB_ID="ca-pub-0000000000000000"
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
