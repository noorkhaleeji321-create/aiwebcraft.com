# ==============================================================================
# AIWebCrafter.com - Environment Configuration Template (.env.example)
# Private Cloud Database, Encryption & Storage Platform (Strictly 0 MAD Free Tier)
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secret keys or passwords to git or public repositories.
# - Copy this file to .env and fill in your actual values.
# - All keys listed here correspond to genuinely 100% FREE services (NO Cloudflare).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# NODE_ENV: وضع التشغيل (development للتطوير المحلي، production للإنتاج على Vercel)
NODE_ENV="production"

# PORT: منفذ خادم المنصة (الافتراضي 3000)
PORT=3000

# APP_URL: رابط استضافة لوحة AIWebCrafter
APP_URL="https://aiwebcrafter.com"

# # GEMINI_API_KEY: مفتاح اختياري يُحقن تلقائياً بواسطة AI Studio عند تفعيل ميزات الذكاء
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"


# ------------------------------------------------------------------------------
# 2. SECURE ADMIN AUTHENTICATION (0 MAD, STATELESS HMAC-SHA256)
# ------------------------------------------------------------------------------
# AWC_ADMIN_EMAIL:
# البريد الإلكتروني الخاص بمدير المنصة والمشرف العام
# الافتراضي: owner@aiwebcrafter.com
AWC_ADMIN_EMAIL="aiwebcraft6@gmail.com"

# AWC_ADMIN_KEY:
# المفتاح السري الإداري الرئيسي (Admin Master Key)
# يُستعمل لتسجيل الدخول إلى لوحة التحكم عبر /api/backend/auth/login وللعمليات الإدارية المباشرة.
# القيمة الافتراضية للتطوير المحلي: aiwebcrafter2026
# ملاحظة: في بيئة الإنتاج (Production)، قم بتغييره إلى كلمة مرور عشوائية قوية وطويلة.
AWC_ADMIN_KEY="YOUR_AWC_ADMIN_MASTER_KEY_HERE"

# AWC_SIGNING_SECRET:
# المفتاح السري لتوقيع جلسات المشرف المشفرة (HMAC-SHA256 Stateless Session Tokens)
# يُستخدم لتوليد والتحقق من ملفات تعريف الارتباط (HttpOnly Cookie) والتوكنات الآمنة في Vercel Serverless.
AWC_SIGNING_SECRET="YOUR_AWC_SIGNING_SECRET_HERE"


# ------------------------------------------------------------------------------
# 3. STOREFRONT API ACCESS (DEDICATED TO NATURAL HEALTH MOROCCO)
# ------------------------------------------------------------------------------
# AWC_STOREFRONT_KEY:
# المفتاح السري المخصص لمتجر Natural Health Morocco (Storefront Scope)
# يُوضع فقط داخل ملف .env الخاص بخادم Node.js/Express في المتجر (وليس في كود المتصفح العام).
# يمنح صلاحيات محددة فقط: قراءة المنتجات والتصنيفات (GET)، وإرسال الطلبات الجديدة (POST /orders).
# يمنع المتجر منعاً باتاً من التعديل أو الحذف أو الإجراءات الإدارية.
AWC_STOREFRONT_KEY="YOUR_STOREFRONT_SECRET_KEY_HERE"


# ------------------------------------------------------------------------------
# 4. CORS & DOMAIN SECURITY
# ------------------------------------------------------------------------------
# AWC_ALLOWED_ORIGIN:
# النطاقات المصرح لها بالتواصل مع الـ Backend وقراءة الكتالوج وإرسال الطلبات
# ضع رابط متجرك الحالي ونطاق لوحة AIWebCrafter مفصولين بفاصلة.
AWC_ALLOWED_ORIGIN="https://natural-health-morocco.vercel.app,http://localhost:3000"


# ------------------------------------------------------------------------------
# 5. ENCRYPTION & BACKUP
# ------------------------------------------------------------------------------
# AWC_BACKUP_PASSPHRASE:
# كلمة المرور الرئيسية لتشفير النسخ الاحتياطية المجمعة (AES-256-GCM)
# تُستخدم لتشفير وفك تشفير ملفات النسخ الاحتياطي المضغوطة (.awc / .zip)
AWC_BACKUP_PASSPHRASE="YOUR_BACKUP_PASSPHRASE_HERE"


# ------------------------------------------------------------------------------
# 6. GITHUB-BACKED PERMANENT STORAGE (STRICTLY 0 MAD, NO CLOUDFLARE)
# ------------------------------------------------------------------------------
# GITHUB_REPO_OWNER:
# اسم حسابك على GitHub
GITHUB_REPO_OWNER="noorkhaleeji321-create"

# GITHUB_REPO_NAME:
# اسم مستودع المتجر على GitHub
GITHUB_REPO_NAME="natural-health-morocco"

# GITHUB_BRANCH:
# الفرع الرئيسي للمستودع (main)
GITHUB_BRANCH="main"

# GITHUB_TOKEN:
# الرمز السري الشخصي لـ GitHub (Fine-Grained Personal Access Token)
# بالصلاحيات: Contents: Read and Write فقط للمستودع المحدد.
# يُوضع حصراً في متغيرات بيئة الخادم على Vercel أو الخادم الآمن (ممنوع في المتصفح).
# NOTE: اتركه فارغاً محلياً لاستخدام نظام التخزين المحلي التلقائي داخل data/products.json و media/products/
GITHUB_TOKEN="YOUR_GITHUB_TOKEN_HERE"

